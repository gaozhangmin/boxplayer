{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BoxPlayer Dev",
  "version": "0.1.0",
  "identifier": "com.boxplayer.migration.dev",
  "build": {
    "beforeDevCommand": "pnpm build:boxplayer && pnpm dev",
    "devUrl": "http://127.0.0.1:1428",
    "beforeBuildCommand": "pnpm build:boxplayer && pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "BoxPlayer Dev",
        "width": 1160,
        "height": 780,
        "minWidth": 760,
        "minHeight": 540,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: mscache: http://mscache.localhost https://mscache.localhost https://api.xbyvideohub.com; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; frame-src 'none'"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "boxplayer-migration-dev",
          "xbyboxplayer-oauth",
          "boxplayer-onedriveoauth"
        ]
      }
    }
  },
  "bundle": {
    "active": false,
    "externalBin": ["binaries/boxplayer-host"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "fileAssociations": [
      {
        "ext": [
          "mp4",
          "mkv",
          "webm",
          "avi",
          "mov"
        ],
        "name": "Media file (BoxPlayer Dev)",
        "role": "Viewer",
        "rank": "Alternate"
      }
    ]
  }
}
