{
  "name": "boxplayer-tauri-dev",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "GPL-3.0-only",
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "build": "pnpm typecheck && vite build",
    "typecheck:boxplayer": "tsc -p tsconfig.boxplayer.json",
    "build:boxplayer": "pnpm typecheck:boxplayer && node scripts/build-boxplayer.mjs",
    "test:boxplayer": "pnpm typecheck:boxplayer && bun test native/boxplayer/tests",
    "preview": "vite preview --host 127.0.0.1",
    "tauri": "node scripts/tauri.mjs"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "2.0.51",
    "@arco-design/web-vue": "2.55.1",
    "@tauri-apps/api": "^2.10.0",
    "ai": "6.0.209",
    "ant-design-vue": "4.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dayjs": "1.11.23",
    "fuzzysort": "2.0.4",
    "lodash": "4.17.21",
    "lucide-vue-next": "^1.0.0",
    "pinia": "^3.0.0",
    "qrcode": "1.5.4",
    "reka-ui": "^2.0.0",
    "tailwind-merge": "^3.0.0",
    "vue": "~3.5.27",
    "vue-sonner": "^2.0.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@tauri-apps/cli": "^2.10.0",
    "@types/better-sqlite3": "9.6.0",
    "@types/bun": "1.4.4",
    "@types/lodash": "4.17.21",
    "@types/node": "^22.0.0",
    "@types/qrcode": "1.5.6",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/test-utils": "^2.4.6",
    "fake-indexeddb": "6.2.7",
    "happy-dom": "^20.0.0",
    "less": "4.6.7",
    "tailwindcss": "^4.0.0",
    "typescript": "~5.9.3",
    "vite": "^7.0.0",
    "vitest": "^3.2.0",
    "vue-tsc": "^3.0.0"
  }
}
