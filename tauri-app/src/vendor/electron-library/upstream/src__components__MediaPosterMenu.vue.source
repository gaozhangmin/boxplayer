<script setup lang="ts">
import { Play, Repeat, Shuffle, Heart, RefreshCw, Eye, EyeOff, ListPlus, Trash2, Star, Share, Download, SquareCheck, Pencil, Bookmark, Library, Move } from 'lucide-vue-next'
import { mediaPosterActions, type PosterAction } from '../utils/mediaPosterMenu'
import { t } from '../i18n'
import { computed, h } from 'vue'
const props = defineProps<{ server?: boolean; tv?: boolean; playlistItem?: boolean; homePlaylistItem?: boolean; seriesItem?: boolean; watched?: boolean; favorite?: boolean; continuing?: boolean; disabled?: PosterAction[]; hideSelect?: boolean; detail?: boolean }>()
defineEmits<{ action: [action: PosterAction] }>()
const FavoriteIcon = (attributes: Record<string, unknown>) => h(Heart, { ...attributes, fill: props.favorite ? 'currentColor' : 'none' })
const icons = computed(() => ({ play: Play, loop: Repeat, shuffle: Shuffle, favorite: FavoriteIcon, refresh: RefreshCw, watched: props.watched ? EyeOff : Eye, playlist: ListPlus, delete: Trash2, removePlaylistItem: Trash2, reorderPlaylistItem: Move, removeSeriesItem: Trash2, reorderSeriesItem: Move, transcode: Play, rating: Star, share: Share, download: Download, select: SquareCheck, metadata: Pencil, continue: Bookmark, series: Library }))
const labels = { play: 'unified.play', loop: 'unified.loopPlay', shuffle: 'unified.shufflePlay', favorite: 'mediaServer.addFavorite', refresh: 'posterMenu.refresh', watched: 'mediaServer.markWatched', playlist: 'media.playlist', delete: 'common.delete', removePlaylistItem: 'posterMenu.removePlaylistItem', reorderPlaylistItem: 'unified.sourceReorder', removeSeriesItem: 'libraryObject.removeSeriesItem', reorderSeriesItem: 'unified.sourceReorder', transcode: 'posterMenu.transcode', rating: 'posterMenu.rating', share: 'fileContext.share', download: 'fileContext.download', select: 'unified.selectItems', metadata: 'fileContext.editMetadata', continue: 'fileContext.continue', series: 'fileContext.series' } as const
</script>
<template><div class="media-poster-menu"><button v-for="action in (homePlaylistItem || playlistItem || seriesItem ? mediaPosterActions(!!server, !!tv, seriesItem ? 'series' : 'playlist') : detail && server ? (['loop', 'shuffle', 'watched', 'favorite', 'playlist', 'rating', 'refresh', 'share', 'download'] as PosterAction[]) : mediaPosterActions(!!server, !!tv)).filter(action => !hideSelect || action !== 'select')" :key="action" type="button" :disabled="disabled?.includes(action)" @click="$emit('action', action)"><component :is="icons[action]" :size="16" /><span>{{ t(action === 'continue' && continuing ? 'fileContext.removeContinue' : action === 'watched' && watched ? 'mediaServer.markUnwatched' : action === 'favorite' && favorite ? 'mediaServer.removeFavorite' : labels[action]) }}</span></button></div></template>
<style scoped>
.media-poster-menu{padding:5px;min-width:140px;border-radius:12px;background:var(--color-bg-popup);color:var(--color-text-1)}button{display:flex;align-items:center;gap:7px;width:100%;min-height:25px;padding:3px 9px;border:0;border-radius:5px;background:transparent;color:inherit;font-size:12px;text-align:left;white-space:nowrap;cursor:pointer}button svg{color:#ff8800;flex-shrink:0}button:hover:not(:disabled){background:rgb(var(--primary-6));color:white}button:disabled{opacity:.4;cursor:not-allowed}
</style>
