import { commonDriveCapabilities, defineProviderCapabilities } from '../services/agent/providerCapabilityTypes'
export default defineProviderCapabilities({ platform: 'dropbox', name: 'Dropbox', capabilities: { ...commonDriveCapabilities }, operations: { 'files.downloadZip': true, 'offline.http': true, 'trash.move': true }, notes: ['支持单个文件夹服务端 ZIP 下载（目录小于 20GB、单文件小于 4GB、总条目少于 10,000），以及 HTTP URL 离线保存（15 分钟超时）。支持将文件或文件夹移入 Dropbox 已删除项目；回收站管理尚未接入。'], evidence: { list: { status: 'tested', implementation: 'src/dropbox/dirfilelist.ts', test: 'src/dropbox/__tests__/dirfilelist.test.ts' }, search: { status: 'tested', implementation: 'src/dropbox/search.ts', test: 'src/dropbox/__tests__/search.test.ts' }, upload: { status: 'tested', implementation: 'src/dropbox/upload.ts', test: 'src/dropbox/__tests__/upload.test.ts' }, share: { status: 'tested', implementation: 'src/dropbox/share.ts', test: 'src/dropbox/__tests__/share.test.ts' }, move: { status: 'tested', implementation: 'src/dropbox/filecmd.ts', test: 'src/dropbox/__tests__/filecmd.test.ts' } } })
